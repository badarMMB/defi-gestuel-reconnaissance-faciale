# Copiez ce fichier en « .env » et remplacez le mot de passe. Le fichier .env n'est pas versionné.
registry=exadel/
postgres_username=postgres
postgres_password=CHANGEZ-MOI
postgres_db=frs
save_images_to_db=false
compreface_api_java_options=-Xmx1g
compreface_admin_java_options=-Xmx1g
max_file_size=5MB
max_request_size=10M
max_detect_size=640
uwsgi_processes=2
uwsgi_threads=1
connection_timeout=10000
read_timeout=60000
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0
POSTGRES_VERSION=1.2.0
