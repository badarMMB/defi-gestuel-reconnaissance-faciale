# Copiez ce fichier en « .env » et remplacez le mot de passe. Le fichier .env n'est pas versionné.
registry=exadel/
postgres_username=postgres
postgres_password=CHANGEZ-MOI
postgres_db=frs
save_images_to_db=false
compreface_api_java_options=-Xmx1g
compreface_admin_java_options=-Xmx1g
max_file_size=5MB
max_request_size=10M
# CompreFace réduit chaque photo à cette largeur avant de chercher les visages, et ignore ceux de moins de 20 pixels.
# À 640, une photo de 1280 est divisée par deux : un visage à plus d'un mètre et demi n'est plus trouvé. À 1280, la
# limite double, pour 0,3 s par reconnaissance.
max_detect_size=1280
uwsgi_processes=2
uwsgi_threads=1
connection_timeout=10000
read_timeout=60000
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0
POSTGRES_VERSION=1.2.0
